# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Cloudflare R2 Storage (Optional - requires setup)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://your-custom-domain.com

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/vibez_db?schema=public"

# Auth
JWT_SECRET="your_jwt_secret_change_this_in_production"

# Android App
BACKEND_URL="https://your-backend-url.com/"
GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

