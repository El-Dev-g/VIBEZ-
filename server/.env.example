# Server Environment Variables
PORT=10000
NODE_ENV=production
DATABASE_URL=postgresql://vibez_user:password@localhost:5432/vibez_db?schema=public
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long
VIBEZ_WEBHOOK_SECRET=your_webhook_secret_key
ADMIN_EMAIL=admin@vibez.com
ADMIN_PASSWORD=your_secure_admin_password
BACKEND_URL=https://vibez-n5h1.onrender.com

# Gmail / Nodemailer Configuration (For Inquiries & Notifications)
# Generate an App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME="VIBEZ Support"
