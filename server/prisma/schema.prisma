// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  phoneNumber   String    @unique
  googleEmail   String?   @unique
  authProvider  String    @default("PHONE") // PHONE, GOOGLE
  name          String?
  avatarUrl     String?
  about         String?   @default("Hey there! I am using Vibez.")
  lastSeen      DateTime  @default(now())
  isBanned      Boolean   @default(false)
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  
  chats            ChatMember[]
  
  statuses         Status[]
  statusViews      StatusView[]
  communities      CommunityMember[]
  callsMade        Call[]    @relation("Caller")
  callsReceived    Call[]    @relation("Receiver")
  settings         UserSettings?
  reportsSubmitted Report[]  @relation("Reporter")
  reportsReceived  Report[]  @relation("ReportedUser")
  badgePayments    BadgePayment[]
  paymentTransactions PaymentTransaction[]
  officialPostReactions PostReaction[]
  officialPostComments  PostComment[]
}

model Chat {
  id          String   @id @default(uuid())
  isGroup     Boolean  @default(false)
  name        String?  // For groups
  avatarUrl   String?  // For groups
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  members     ChatMember[]
  
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model ChatMember {
  id        String   @id @default(uuid())
  userId    String
  chatId    String
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

model Message {
  id          String      @id @default(uuid())
  content     String
  type        String      @default("TEXT") // TEXT, IMAGE, VIDEO, AUDIO, LOCATION, CONTACT
  status      String      @default("SENT") // SENT, DELIVERED, READ
  mediaUrl    String?
  duration    Int?        // For audio/video
  
  senderId    String
  chatId      String
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String?     // Nullable for group messages
  receiver    User?       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  chat        Chat        @relation(fields: [chatId], references: [id])
}

model Status {
  id              String   @id @default(uuid())
  userId          String
  mediaUrl        String?
  content         String?
  type            String   @default("IMAGE") // TEXT, IMAGE, VIDEO
  backgroundColor String?
  textStyle       String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  
  user            User     @relation(fields: [userId], references: [id])
  views           StatusView[]
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String
  userId    String
  viewedAt  DateTime @default(now())

  status    Status   @relation(fields: [statusId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, statusId])
}

model Community {
  id            String   @id @default(uuid())
  name          String
  description   String?
  avatarUrl     String?
  ownerId       String
  createdAt     DateTime @default(now())
  
  isOfficial    Boolean  @default(false)
  allowComments Boolean  @default(true)
  allowReactions Boolean @default(true)

  members       CommunityMember[]
  channels      Chat[] // Communities have multiple group chats
  posts         OfficialPost[]
}

model OfficialPost {
  id            String   @id @default(uuid())
  communityId   String
  content       String
  type          String   @default("TEXT") // TEXT, IMAGE, VIDEO
  mediaUrl      String?
  createdAt     DateTime @default(now())
  
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  reactions     PostReaction[]
  comments      PostComment[]
}

model PostReaction {
  id            String   @id @default(uuid())
  postId        String
  userId        String
  emoji         String   @default("👍")
  createdAt     DateTime @default(now())

  post          OfficialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@unique([postId, userId, emoji])
}

model PostComment {
  id            String   @id @default(uuid())
  postId        String
  userId        String
  content       String
  createdAt     DateTime @default(now())

  post          OfficialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        String   @default("MEMBER") // ADMIN, MEMBER
  
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

model Call {
  id          String   @id @default(uuid())
  callerId    String
  receiverId  String
  type        String   @default("VOICE") // VOICE, VIDEO
  status      String   @default("COMPLETED") // MISSED, COMPLETED, REJECTED
  duration    Int?
  createdAt   DateTime @default(now())
  
  caller      User     @relation("Caller", fields: [callerId], references: [id])
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id])
}

model UserSettings {
  id                  String  @id @default(uuid())
  userId              String  @unique
  statusPrivacyMode   String  @default("MY_CONTACTS") // MY_CONTACTS, EXCEPT, ONLY_SHARE
  lastSeenPrivacy     String  @default("EVERYONE")
  profilePhotoPrivacy String  @default("EVERYONE")
  aboutPrivacy        String  @default("EVERYONE")
  readReceipts        Boolean @default(true)
  notificationsEnabled Boolean @default(true)
  
  user                User    @relation(fields: [userId], references: [id])
  
  excludedStatusUserIds String[]
  includedStatusUserIds String[]
}

model Admin {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String?  @default("System Admin")
  photo            String?  @default("")
  role             String   @default("MODERATOR") // SUPERADMIN, MODERATOR, SUPPORT
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Report {
  id              String   @id @default(uuid())
  reporterId      String
  reportedUserId  String
  reason          String
  status          String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt       DateTime @default(now())

  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser    User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  adminEmail  String
  action      String
  target      String
  timestamp   DateTime @default(now())
}

model Broadcast {
  id             String   @id @default(uuid())
  title          String
  message        String
  targetAudience String   @default("ALL") // ALL, VERIFIED_ONLY, ADMINS
  sentBy         String   @default("System Admin")
  sentAt         DateTime @default(now())
}

model SystemSetting {
  id                    String  @id @default(uuid())
  allowNewRegistrations Boolean @default(true)
  maintenanceMode       Boolean @default(false)
  maxGroupSize          Int     @default(1024)
  retentionDays         Int     @default(90)
  verificationBadgePrice Float  @default(3.00)
  appDownloadUrl        String? @default("")
  appVersion            String? @default("1.0.0")
  appName               String? @default("VIBEZ")
  contactEmail          String? @default("support@vibez.chat")
  contactPhone          String? @default("+1 (800) 555-0199")
  supportAddress        String? @default("San Francisco, CA, USA")
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?  @default("General Inquiry")
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
}

model BadgePayment {
  id              String   @id @default(uuid())
  userId          String
  amount          Float    @default(3.00)
  currency        String   @default("USD")
  status          String   @default("COMPLETED")
  paymentProvider String   @default("IN_APP_PAYMENT")
  transactionId   String   @unique
  rawReceipt      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model StorageAsset {
  id          String   @id @default(uuid())
  fileKey     String   @unique
  fileName    String
  contentType String
  size        Int      @default(0) // in bytes
  publicUrl   String
  uploaderId  String?  // userId if applicable
  purpose     String   @default("GENERAL") // CHAT, STATUS, COMMUNITY, PROFILE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentProvider {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "STRIPE", "PAYPAL"
  isEnabled   Boolean  @default(false)
  config      Json?    // Encrypted or secure storage of keys (publicKey, secretKey, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String
  amount          Float
  currency        String   @default("USD")
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  provider        String   // STRIPE, PAYPAL
  providerRef     String?  @unique // Provider's internal ID
  metadata        Json?    // For extra data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

